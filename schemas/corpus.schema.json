{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devenvthreatcorpus.invalid/schemas/corpus-0.3.0.json",
  "title": "DevEnvThreatCorpus 0.3.0 foundation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "sources", "sourceRevisions", "passages", "cases", "claims", "categorizations", "timelines", "reviews", "collectionManifests", "governance"],
  "properties": {
    "schemaVersion": { "const": "0.3.0" },
    "name": { "$ref": "#/$defs/text" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "sourceRevisions": { "type": "array", "items": { "$ref": "#/$defs/sourceRevision" } },
    "passages": { "type": "array", "items": { "$ref": "#/$defs/passage" } },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "categorizations": { "type": "array", "items": { "$ref": "#/$defs/categorization" } },
    "timelines": { "type": "array", "items": { "$ref": "#/$defs/timeline" } },
    "reviews": { "type": "array", "items": { "$ref": "#/$defs/review" } },
    "collectionManifests": { "type": "array", "items": { "$ref": "#/$defs/manifest" } },
    "governance": { "$ref": "#/$defs/governance" },
    "behaviors": { "type": "array", "items": { "$ref": "#/$defs/behavior" } },
    "paths": { "type": "array", "items": { "$ref": "#/$defs/path" } },
    "frameworks": { "type": "array", "items": { "$ref": "#/$defs/technique" } },
    "mappings": { "type": "array", "items": { "$ref": "#/$defs/mapping" } },
    "telemetry": { "type": "array", "items": { "$ref": "#/$defs/telemetry" } },
    "detections": { "type": "array", "items": { "$ref": "#/$defs/detection" } },
    "otel": { "type": "array", "items": { "$ref": "#/$defs/otel" } },
    "otelReference": { "type": "object" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "supportIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "nullableText": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "nullReasons": { "type": "object", "additionalProperties": { "enum": ["unknown", "not_reported", "not_applicable"] } },
    "aliasValues": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "governance": {
      "type": "object",
      "properties": {
        "controlledAliases": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/aliasValues" }
        }
      }
    },
    "lifecycle": { "enum": ["Collected", "Extracted — review pending", "Reviewed", "Needs correction", "Excluded"] },
    "disposition": { "enum": ["Pending", "Accepted", "Needs correction", "Excluded"] },
    "evidenceStatus": { "enum": ["Source-reported observation", "Attempted behavior", "Demonstrated capability or proof of concept", "Potential consequence", "Researcher inference", "Unclear or disputed"] },
    "origin": { "enum": ["Human authored", "Human source paraphrase", "Human inference", "Official framework", "LLM source paraphrase", "LLM synthesis", "LLM reconstruction", "LLM inferred relationship", "LLM inferred mapping", "LLM normalized behavior", "LLM proposed categorization", "LLM proposed collection", "LLM proposed detection", "LLM proposed instrumentation", "LLM synthetic fixture; not incident evidence"] },
    "trustSurface": { "enum": ["Social engineering and malicious repositories", "Package or registry compromise", "IDE and local execution paths", "Skill marketplace poisoning", "MCP or tool poisoning", "Credentials and identity", "CI/CD and cloud", null] },
    "aiInvolvement": { "enum": ["Victim-side agent abuse", "Attacker-side AI use", "AI review targeting", "AI assets targeted", "No AI involvement reported", "Unclear", null] },
    "executionLocation": { "enum": ["endpoint", "IDE", "CLI", "WSL", "container", "CI runner", "cloud", "remote service", "unknown", null] },
    "delivery": { "enum": ["recruiter lure", "repository content", "package install/update", "extension", "Skill", "MCP integration", "configuration change", "other", null] },
    "objective": { "enum": ["credential theft", "data theft", "persistence", "execution", "lateral movement", "disruption", "other/unknown", null] },
    "evidenceToSeek": { "enum": ["native agent records", "endpoint telemetry", "package provenance", "repository/CI records", "identity/cloud logs", "network records", null] },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "suppliedBy", "description", "nullReasons"],
      "properties": { "kind": { "enum": ["supplied-text", "supplied-url"] }, "suppliedBy": { "$ref": "#/$defs/nullableText" }, "description": { "$ref": "#/$defs/text" }, "nullReasons": { "$ref": "#/$defs/nullReasons" } }
    },
    "date": {
      "type": "object", "additionalProperties": false,
      "required": ["precision", "value", "start", "end", "nullReasons"],
      "properties": { "precision": { "enum": ["day", "month", "year", "range", "unknown"] }, "value": { "$ref": "#/$defs/nullableText" }, "start": { "$ref": "#/$defs/nullableText" }, "end": { "$ref": "#/$defs/nullableText" }, "nullReasons": { "$ref": "#/$defs/nullReasons" } }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "originalUrl", "canonicalUrl", "title", "publisher", "author", "publicationDate", "updateDate", "retrievalDate", "inputKind", "provenance", "revisionIds", "extractionStatus", "collectionState", "nullReasons"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "originalUrl": { "$ref": "#/$defs/nullableText" }, "canonicalUrl": { "$ref": "#/$defs/nullableText" }, "title": { "$ref": "#/$defs/nullableText" }, "publisher": { "$ref": "#/$defs/nullableText" }, "author": { "$ref": "#/$defs/nullableText" },
        "publicationDate": { "$ref": "#/$defs/date" }, "updateDate": { "$ref": "#/$defs/date" }, "retrievalDate": { "$ref": "#/$defs/date" },
        "inputKind": { "enum": ["url", "supplied-text", "text-file"] }, "provenance": { "$ref": "#/$defs/provenance" }, "revisionIds": { "$ref": "#/$defs/ids" },
        "extractionStatus": { "enum": ["Not started", "Pending", "Extracted", "Failed", "Unavailable"] }, "collectionState": { "$ref": "#/$defs/lifecycle" }, "nullReasons": { "$ref": "#/$defs/nullReasons" }
      }
    },
    "sourceRevision": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourceId", "rawHash", "normalizedHash", "normalizationVersion", "parserVersion", "provenance", "rawContent", "normalizedContent", "retention", "nullReasons"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "sourceId": { "$ref": "#/$defs/id" }, "rawHash": { "$ref": "#/$defs/nullableHash" }, "normalizedHash": { "$ref": "#/$defs/nullableHash" },
        "normalizationVersion": { "$ref": "#/$defs/text" }, "parserVersion": { "$ref": "#/$defs/text" }, "provenance": { "$ref": "#/$defs/provenance" },
        "rawContent": { "$ref": "#/$defs/nullableText" }, "normalizedContent": { "$ref": "#/$defs/nullableText" }, "retention": { "enum": ["private", "permitted-public", "not-retained"] },
        "nullReasons": { "$ref": "#/$defs/nullReasons" }
      }
    },
    "attestation": {
      "type": "object", "additionalProperties": false, "required": ["reviewer", "reviewerKind", "timestamp", "revisionHash", "rationale"],
      "properties": { "reviewer": { "$ref": "#/$defs/text" }, "reviewerKind": { "const": "human" }, "timestamp": { "$ref": "#/$defs/text" }, "revisionHash": { "$ref": "#/$defs/hash" }, "rationale": { "$ref": "#/$defs/text" } }
    },
    "passage": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourceRevisionId", "text", "locator", "start", "end", "attestation", "nullReasons"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "sourceRevisionId": { "$ref": "#/$defs/id" }, "text": { "$ref": "#/$defs/nullableText" }, "locator": { "$ref": "#/$defs/text" }, "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 1 }, "attestation": { "anyOf": [{ "$ref": "#/$defs/attestation" }, { "type": "null" }] }, "nullReasons": { "$ref": "#/$defs/nullReasons" } }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "aliases", "kind", "summary", "summaryClaimIds", "sourceIds", "collectionState", "disposition", "limits", "origin", "revision", "history", "nullReasons"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "aliases": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }, "kind": { "enum": ["Campaign", "Incident", "Research exercise", "Comparator", "Composite playbook", "Other"] },
        "summary": { "$ref": "#/$defs/nullableText" }, "summaryClaimIds": { "$ref": "#/$defs/ids" }, "sourceIds": { "$ref": "#/$defs/supportIds" }, "collectionState": { "$ref": "#/$defs/lifecycle" }, "disposition": { "$ref": "#/$defs/disposition" },
        "limits": { "$ref": "#/$defs/nullableText" }, "origin": { "$ref": "#/$defs/origin" }, "revision": { "$ref": "#/$defs/id" }, "history": { "$ref": "#/$defs/ids" }, "pathIds": { "$ref": "#/$defs/ids" },
        "nullReasons": { "$ref": "#/$defs/nullReasons" }
      }
    },
    "inference": {
      "type": "object", "additionalProperties": false, "required": ["rationale", "supportingClaimIds"],
      "properties": { "rationale": { "$ref": "#/$defs/text" }, "supportingClaimIds": { "$ref": "#/$defs/supportIds" } }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "caseId", "sourceId", "sourceRevisionId", "description", "passageIds", "inference", "evidenceStatus", "origin", "disposition", "revision", "history", "conflictsWith", "uncertainty", "observationContext", "nullReasons"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "caseId": { "$ref": "#/$defs/id" }, "sourceId": { "$ref": "#/$defs/id" }, "sourceRevisionId": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/text" }, "passageIds": { "$ref": "#/$defs/ids" },
        "inference": { "anyOf": [{ "$ref": "#/$defs/inference" }, { "type": "null" }] }, "evidenceStatus": { "$ref": "#/$defs/evidenceStatus" }, "origin": { "$ref": "#/$defs/origin" }, "disposition": { "$ref": "#/$defs/disposition" },
        "revision": { "$ref": "#/$defs/id" }, "history": { "$ref": "#/$defs/ids" }, "conflictsWith": { "$ref": "#/$defs/ids" }, "uncertainty": { "$ref": "#/$defs/nullableText" }, "observationContext": { "$ref": "#/$defs/nullableText" },
        "nullReasons": { "$ref": "#/$defs/nullReasons" }
      }
    },
    "categorization": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "caseId", "dimension", "value", "otherText", "sourceIds", "supportingClaimIds", "origin", "disposition", "revision", "history", "nullReasons"],
      "allOf": [
        { "if": { "properties": { "dimension": { "const": "trust_surface" } } }, "then": { "properties": { "value": { "$ref": "#/$defs/trustSurface" } } } },
        { "if": { "properties": { "dimension": { "const": "ai_involvement" } } }, "then": { "properties": { "value": { "$ref": "#/$defs/aiInvolvement" } } } },
        { "if": { "properties": { "dimension": { "const": "execution_location" } } }, "then": { "properties": { "value": { "$ref": "#/$defs/executionLocation" } } } },
        { "if": { "properties": { "dimension": { "const": "delivery" } } }, "then": { "properties": { "value": { "$ref": "#/$defs/delivery" } } } },
        { "if": { "properties": { "dimension": { "const": "objective" } } }, "then": { "properties": { "value": { "$ref": "#/$defs/objective" } } } },
        { "if": { "properties": { "dimension": { "const": "evidence_to_seek" } } }, "then": { "properties": { "value": { "$ref": "#/$defs/evidenceToSeek" } } } }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "caseId": { "$ref": "#/$defs/id" }, "dimension": { "enum": ["trust_surface", "ai_involvement", "execution_location", "delivery", "objective", "evidence_to_seek", "tool", "platform", "tag"] },
        "value": { "$ref": "#/$defs/nullableText" }, "otherText": { "$ref": "#/$defs/nullableText" }, "sourceIds": { "$ref": "#/$defs/supportIds" }, "supportingClaimIds": { "$ref": "#/$defs/supportIds" }, "origin": { "$ref": "#/$defs/origin" },
        "disposition": { "$ref": "#/$defs/disposition" }, "revision": { "$ref": "#/$defs/id" }, "history": { "$ref": "#/$defs/ids" }, "nullReasons": { "$ref": "#/$defs/nullReasons" }
      }
    },
    "timeline": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "caseId", "description", "date", "dateType", "supportingClaimIds", "sourceRevisionIds", "basis", "uncertainty", "origin", "disposition", "revision", "history", "nullReasons"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "caseId": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/text" }, "date": { "$ref": "#/$defs/date" }, "dateType": { "enum": ["publication", "source_update", "first_reported_activity", "incident_execution", "discovery", "disclosure"] },
        "supportingClaimIds": { "$ref": "#/$defs/ids" }, "sourceRevisionIds": { "$ref": "#/$defs/ids" }, "basis": { "$ref": "#/$defs/text" }, "uncertainty": { "$ref": "#/$defs/nullableText" }, "origin": { "$ref": "#/$defs/origin" },
        "disposition": { "$ref": "#/$defs/disposition" }, "revision": { "$ref": "#/$defs/id" }, "history": { "$ref": "#/$defs/ids" }, "nullReasons": { "$ref": "#/$defs/nullReasons" }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "entityType", "entityId", "revision", "baseDigest", "reviewer", "reviewerKind", "timestamp", "disposition", "rationale", "contentHash", "dependencyHashes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "entityType": { "enum": ["cases", "claims", "categorizations", "timelines"] }, "entityId": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/id" }, "baseDigest": { "$ref": "#/$defs/hash" },
        "reviewer": { "$ref": "#/$defs/text" }, "reviewerKind": { "enum": ["human", "agent"] }, "timestamp": { "$ref": "#/$defs/text" }, "disposition": { "$ref": "#/$defs/disposition" },
        "rationale": { "$ref": "#/$defs/text" }, "contentHash": { "$ref": "#/$defs/hash" }, "dependencyHashes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hash" } }
      }
    },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "inputSourceIds", "inputRevisionIds", "outcome", "provenance", "toolVersion", "inputHash", "outputHash", "limitations", "nullReasons"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["manual-collection", "extraction"] }, "inputSourceIds": { "$ref": "#/$defs/ids" }, "inputRevisionIds": { "$ref": "#/$defs/ids" }, "outcome": { "enum": ["Pending", "Succeeded", "Partial", "Failed"] },
        "provenance": { "$ref": "#/$defs/provenance" }, "toolVersion": { "$ref": "#/$defs/text" }, "inputHash": { "$ref": "#/$defs/nullableHash" }, "outputHash": { "$ref": "#/$defs/nullableHash" }, "limitations": { "type": "array", "items": { "$ref": "#/$defs/text" } }, "nullReasons": { "$ref": "#/$defs/nullReasons" }
      }
    },
    "node": {
      "type": "object", "required": ["id", "title", "detail", "claimIds", "behaviorIds", "evidenceStatus", "origin", "disposition"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "detail": { "$ref": "#/$defs/text" }, "claimIds": { "$ref": "#/$defs/supportIds" }, "behaviorIds": { "$ref": "#/$defs/ids" }, "evidenceStatus": { "$ref": "#/$defs/evidenceStatus" }, "origin": { "$ref": "#/$defs/origin" }, "disposition": { "$ref": "#/$defs/disposition" } }
    },
    "edge": {
      "type": "object", "required": ["id", "from", "to", "claimIds", "relation", "basis", "origin"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" }, "claimIds": { "$ref": "#/$defs/supportIds" }, "relation": { "enum": ["sequence", "conditional", "propagates"] }, "basis": { "$ref": "#/$defs/text" }, "origin": { "$ref": "#/$defs/origin" } }
    },
    "path": {
      "type": "object", "required": ["id", "caseId", "nodes", "edges", "scope", "origin", "disposition"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "caseId": { "$ref": "#/$defs/id" }, "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }, "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }, "scope": { "enum": ["representative", "composite"] }, "origin": { "$ref": "#/$defs/origin" }, "disposition": { "$ref": "#/$defs/disposition" } }
    },
    "behavior": {
      "type": "object", "required": ["id", "namespace", "name", "boundary", "description", "signalIds", "detectionIds", "otelIds", "origin", "disposition"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "namespace": { "$ref": "#/$defs/text" }, "name": { "$ref": "#/$defs/text" }, "boundary": { "$ref": "#/$defs/text" }, "description": { "$ref": "#/$defs/text" }, "signalIds": { "$ref": "#/$defs/ids" }, "detectionIds": { "$ref": "#/$defs/ids" }, "otelIds": { "$ref": "#/$defs/ids" }, "origin": { "$ref": "#/$defs/origin" }, "disposition": { "$ref": "#/$defs/disposition" } }
    },
    "technique": {
      "type": "object", "required": ["id", "name", "framework", "version", "sourceId", "url"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "framework": { "enum": ["ATLAS", "ATT&CK"] }, "version": { "$ref": "#/$defs/text" }, "sourceId": { "$ref": "#/$defs/id" }, "url": { "$ref": "#/$defs/text" }, "parentId": { "$ref": "#/$defs/nullableText" }, "tacticIds": { "$ref": "#/$defs/ids" }, "maturity": { "$ref": "#/$defs/text" } }
    },
    "mapping": {
      "type": "object", "required": ["id", "caseId", "behaviorId", "framework", "version", "techniqueId", "claimIds", "rationale", "applicability", "origin", "mappingStatus", "disposition"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "caseId": { "$ref": "#/$defs/id" }, "behaviorId": { "$ref": "#/$defs/id" }, "framework": { "$ref": "#/$defs/text" }, "version": { "$ref": "#/$defs/text" }, "techniqueId": { "$ref": "#/$defs/id" }, "pathId": { "$ref": "#/$defs/id" }, "nodeId": { "$ref": "#/$defs/id" }, "claimIds": { "$ref": "#/$defs/supportIds" }, "rationale": { "$ref": "#/$defs/text" }, "applicability": { "$ref": "#/$defs/text" }, "origin": { "$ref": "#/$defs/origin" }, "mappingStatus": { "enum": ["Proposed", "Reviewed", "Rejected"] }, "disposition": { "$ref": "#/$defs/disposition" }, "provisional": { "type": "boolean" } }
    },
    "telemetry": {
      "type": "object", "required": ["id", "behaviorId", "category", "eventType", "logicalFields", "joinKeys", "availability", "schema", "limitations", "origin", "disposition"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "behaviorId": { "$ref": "#/$defs/id" }, "category": { "$ref": "#/$defs/text" }, "eventType": { "$ref": "#/$defs/text" }, "logicalFields": { "type": "array", "items": { "$ref": "#/$defs/text" } }, "joinKeys": { "type": "array", "items": { "$ref": "#/$defs/text" } }, "availability": { "$ref": "#/$defs/text" }, "schema": { "$ref": "#/$defs/text" }, "limitations": { "$ref": "#/$defs/text" }, "origin": { "$ref": "#/$defs/origin" }, "disposition": { "$ref": "#/$defs/disposition" } }
    },
    "detection": {
      "type": "object", "required": ["id", "behaviorId", "hypothesis", "signalIds", "otelIds", "windowSeconds", "windowBasis", "tuning", "testPlan", "validation", "origin", "disposition"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "behaviorId": { "$ref": "#/$defs/id" }, "hypothesis": { "$ref": "#/$defs/text" }, "signalIds": { "$ref": "#/$defs/ids" }, "otelIds": { "$ref": "#/$defs/ids" }, "windowSeconds": { "type": "integer", "minimum": 1 }, "windowBasis": { "$ref": "#/$defs/text" }, "tuning": { "$ref": "#/$defs/text" }, "testPlan": { "$ref": "#/$defs/text" }, "validation": { "$ref": "#/$defs/text" }, "origin": { "$ref": "#/$defs/origin" }, "disposition": { "$ref": "#/$defs/disposition" } }
    },
    "otel": {
      "type": "object", "required": ["id", "behaviorId", "action", "standardSourceIds", "customFields", "sample", "sampleFormat", "sampleOrigin", "stability", "limitations", "origin", "disposition"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "behaviorId": { "$ref": "#/$defs/id" }, "action": { "$ref": "#/$defs/text" }, "standardSourceIds": { "$ref": "#/$defs/ids" }, "customFields": { "type": "array", "items": { "$ref": "#/$defs/text" } }, "sample": { "type": "object" }, "sampleFormat": { "$ref": "#/$defs/text" }, "sampleOrigin": { "$ref": "#/$defs/text" }, "stability": { "$ref": "#/$defs/text" }, "limitations": { "$ref": "#/$defs/text" }, "origin": { "$ref": "#/$defs/origin" }, "disposition": { "$ref": "#/$defs/disposition" } }
    }
  }
}
